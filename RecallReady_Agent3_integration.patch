+def _normalize_upc_digits(value: str | None) -> str | None:
+    if not value:
+        return None
+    cleaned = re.sub(r"[\s\-]+", "", value)
+    if cleaned and cleaned.isdigit():
+        return cleaned
+    return None
+
+
+def _parse_package_value_unit(value: str | None) -> tuple[float, str] | None:
+    if not value or not value.strip():
+        return None
+    match = re.fullmatch(
+        r"\s*(\d+(?:\.\d+)?)\s*(oz|ounces?|lb|lbs|pounds?|g|grams?|kg|kilograms?|gallons?|gal)\.?\s*",
+        value,
+        re.IGNORECASE,
+    )
+    if not match:
+        return None
+    num = float(match.group(1))
+    raw_unit = match.group(2).lower()
+    unit_map = {
+        "oz": "oz",
+        "ounce": "oz",
+        "ounces": "oz",
+        "lb": "lb",
+        "lbs": "lb",
+        "pound": "lb",
+        "pounds": "lb",
+        "g": "g",
+        "gram": "g",
+        "grams": "g",
+        "kg": "kg",
+        "kilogram": "kg",
+        "kilograms": "kg",
+        "gallon": "gallon",
+        "gallons": "gallon",
+        "gal": "gallon",
+    }
+    return (num, unit_map[raw_unit])
